{{#each post}} 
  <div class="p-3">
    <div class="card mb-3">
      <div class="card-header">
        <small class="text-muted d-flex justify-content-between">
          <span class="mr-2"><a href="/{{nome}}">{{nome}}</a></span>
          <span>{{post_like}}</span>
        </small>
      </div>
      <div class="card-body">
        <div class="card-text">
          {{{conteudo}}}
        </div>
      </div>
      <div class="card-footer">
        <form action="/post/{{id}}/like" method="post">
          <button class="btn btn-sm btn-outline-danger">
            Curtidas
            <span class="badge bg-danger">{{post_like}}</span>
          </button>
        </form>
    </div>
  </div>
{{/each}}
<div class="container mb-3">
  <div class="card">
    <div class="card-header text-muted">
      <span>Comentário</span>
    </div>
    <div class="card-body">
      <form action="/post/{{id}}/comentar" method="post">
        <div class="mb-3">
          <textarea class="form-control" id="comentario" name="comentario" rows="3" style="height: 144px;" required></textarea>
        </div>
      
        <button type="submit" class="btn btn-outline-success">Comentar</button>
        <button type="reset" class="btn btn-outline-danger">
          Cancelar
        </button>
      </form>
    </div>
  </div>
</div>